# Docs site build-time env vars. Copy to .env.local to test locally (gitignored).
#
# Google Analytics (GA4) measurement ID. When set, the docs site injects the
# gtag.js snippet (see .vitepress/config.ts). Leave UNSET in the public repo;
# set the real value only in the Netlify build environment so forks/clones do
# not report analytics to the project's property.
GA_MEASUREMENT_ID=
