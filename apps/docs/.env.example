# Docs site build-time env vars. Copy to apps/docs/.env (gitignored) to bake
# these into a local or docker build; .vitepress/config.ts loads the file via
# loadEnv, and a value already exported in the shell wins over the file.
# Production deploys get them from GitHub Actions secrets (deploy-docs.yml),
# so this file is only needed for local builds.
#
# Google Analytics (GA4) measurement ID. When set, the docs site injects the
# gtag.js snippet (see .vitepress/analyticsHead.mjs). Leave UNSET in the
# public repo so forks/clones do not report analytics to the project's
# property.
GA_MEASUREMENT_ID=

# Google Search Console site-verification token (HTML-tag/meta method) for
# the URL-prefix property https://michi-vz.netlify.app/. Same gating as
# GA_MEASUREMENT_ID.
GOOGLE_SITE_VERIFICATION=
