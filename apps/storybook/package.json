{
  "name": "@michi-vz/storybook",
  "private": true,
  "version": "1.1.3",
  "type": "module",
  "description": "Storybook for the @michi-vz native web components (Lit, light DOM). Stories derive from @michi-vz/examples so they never drift from the docs.",
  "scripts": {
    "storybook": "storybook dev -p 6006 --no-open",
    "build-storybook": "storybook build -o storybook-static",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@michi-vz/examples": "workspace:*",
    "@michi-vz/wc": "workspace:*"
  },
  "devDependencies": {
    "@storybook/addon-essentials": "^8.6.14",
    "@storybook/web-components": "^8.6.14",
    "@storybook/web-components-vite": "^8.6.14",
    "lit": "^3.2.1",
    "storybook": "^8.6.14",
    "typescript": "^5.6.3",
    "vite": "^5.4.11"
  }
}
