{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": [],
    "resolveJsonModule": true,
    "esModuleInterop": true
  },
  "include": [".storybook/**/*.ts", "src/**/*.ts"]
}
