{
  "name": "@michi-vz/core",
  "version": "1.19.1",
  "description": "Framework-agnostic chart engine - SVG, canvas & WebGPU renderers, accessible by default, emitting an LLM-ready ChartContext. No framework dependencies.",
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./styles.css": "./dist/styles/core.css"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vitest run"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "d3-array": "^3.2.4",
    "d3-force": "^3.0.0",
    "d3-geo": "^3.1.1",
    "d3-geo-projection": "^4.0.0",
    "d3-hierarchy": "^3.1.2",
    "d3-sankey": "^0.12.3",
    "d3-scale": "^4.0.2",
    "d3-shape": "^3.2.0",
    "dompurify": "^3.4.12"
  },
  "devDependencies": {
    "@types/d3-array": "^3.2.1",
    "@types/d3-force": "^3.0.10",
    "@types/d3-geo": "^3.1.0",
    "@types/d3-hierarchy": "^3.1.7",
    "@types/d3-sankey": "^0.12.4",
    "@types/d3-scale": "^4.0.8",
    "@types/d3-shape": "^3.1.7",
    "@types/geojson": "^7946.0.16",
    "@webgpu/types": "^0.1.71",
    "jsdom": "^25.0.1",
    "vitest": "^3.2.6"
  },
  "license": "MIT",
  "author": "Beany Vu",
  "keywords": [
    "charts",
    "charting",
    "charting-library",
    "dataviz",
    "data-visualization",
    "visualization",
    "graph",
    "svg",
    "canvas",
    "webgpu",
    "responsive",
    "typescript",
    "accessibility",
    "a11y",
    "d3",
    "framework-agnostic",
    "llm",
    "ai",
    "llm-ready",
    "mcp",
    "michi-vz",
    "engine",
    "vanilla-js",
    "headless"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/beany-vu/michi-vz-mono.git",
    "directory": "packages/core"
  },
  "homepage": "https://michi-vz.netlify.app/",
  "bugs": "https://github.com/beany-vu/michi-vz-mono/issues"
}
