{
  "name": "@michi-vz/wc",
  "version": "1.10.1",
  "description": "Native web components (Lit, light DOM) for michi-vz charts - SVG, canvas & WebGPU rendering, styleable with your own CSS, accessible, and LLM-ready.",
  "type": "module",
  "files": [
    "dist"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "jsdelivr": "./dist/michi-vz-wc.bundle.js",
  "unpkg": "./dist/michi-vz-wc.bundle.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./gap-chart": {
      "types": "./dist/gap-chart.d.ts",
      "import": "./dist/gap-chart.js",
      "require": "./dist/gap-chart.cjs"
    },
    "./line-chart": {
      "types": "./dist/line-chart.d.ts",
      "import": "./dist/line-chart.js",
      "require": "./dist/line-chart.cjs"
    },
    "./area-chart": {
      "types": "./dist/area-chart.d.ts",
      "import": "./dist/area-chart.js",
      "require": "./dist/area-chart.cjs"
    },
