{
  "name": "@michi-vz/svelte",
  "version": "1.4.0",
  "description": "Svelte charts - SVG, canvas & WebGPU rendering, accessible by default, with an LLM-ready data context. Thin wrapper over the framework-agnostic @michi-vz engine.",
  "type": "module",
  "files": [
    "dist"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@michi-vz/core": "workspace:*"
  },
  "peerDependencies": {
    "svelte": ">=4"
  },
  "license": "MIT",
  "author": "Beany Vu",
  "keywords": [
    "charts",
    "charting",
    "charting-library",
    "dataviz",
    "data-visualization",
    "visualization",
    "graph",
    "svg",
    "canvas",
    "webgpu",
    "responsive",
    "typescript",
    "accessibility",
    "a11y",
    "d3",
    "framework-agnostic",
    "llm",
    "ai",
    "llm-ready",
    "mcp",
    "michi-vz",
    "svelte",
    "sveltejs",
    "svelte-charts"
  ],
  "sideEffects": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/beany-vu/michi-vz-mono.git",
    "directory": "packages/svelte"
  },
  "homepage": "https://michi-vz.netlify.app/",
  "bugs": "https://github.com/beany-vu/michi-vz-mono/issues"
}
